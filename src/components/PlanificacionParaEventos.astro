---
const { dataProducts } = Astro.props;
---

<section class="py-12 bg-[#dbc0a7]">
  <div class="container mx-auto text-center">
    <h2 class="text-4xl text-[#5a2e1b] mb-8 font-bold">Panificación para Eventos</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {Object.values(dataProducts).map((producto, i) => (
        <div 
          key={i} 
          class="flex flex-col items-center p-4 sm:p-6 bg-[#f4e4d4] rounded-xl shadow-lg transition-transform duration-300 hover:shadow-2xl hover:scale-105 max-w-[90%] sm:max-w-full mx-auto">
          <div class="w-full max-w-[180px] sm:max-w-[200px] bg-[#896029de] p-2 rounded-lg shadow-md">
            <img src={producto.imagenPrincipal} alt={producto.titulo} class="w-full h-auto object-cover rounded-lg" />
          </div>
          <p class="mt-3 text-[#4a2c1a] font-semibold text-base sm:text-lg">{producto.titulo}</p>
          <a 
            href="https://api.whatsapp.com/send?phone=5491166505422" 
            target="_blank"
            class="mt-4 bg-[#5c3d2e] hover:bg-[#3e2b23] text-white px-4 py-2 rounded-lg shadow-md font-medium text-sm sm:text-base transition-all">
            Contactar
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
