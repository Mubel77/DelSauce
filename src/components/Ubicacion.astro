---
// Cargando el componente de Astro con la propiedad dataContact
const { dataContact } = Astro.props;
---

<div 
  id="ubicacion" 
  class="bg-[#d0b8a8] text-[#5c3d2e] rounded-2xl p-8 mt-20 mb-10 flex flex-col items-center shadow-lg opacity-0 transition-opacity duration-1000" 
  style="visibility: hidden;" 
>
  <h2 class="text-center text-3xl md:text-5xl font-bold mb-6">{dataContact.titulo}</h2>

  <div class="grid md:grid-cols-2 gap-8 md:gap-16 w-full items-center">
    <!-- Información de Contacto -->
    <div class="space-y-6">
      <!-- Teléfono -->
      <a href={`tel:${dataContact.telefono}`} class="flex items-center space-x-4" data-aos="fade-up" data-aos-duration="1000">
        <img src={dataContact.imagenTelefono} alt="Teléfono" class="w-8 h-8" />
        <p class="text-lg">{dataContact.telefono}</p>
      </a>

      <!-- Email -->
      <a href={`mailto:${dataContact.email}`} class="flex items-center space-x-4" data-aos="fade-up" data-aos-duration="1000">
        <img src={dataContact.imagenEmail} alt="Email" class="w-8 h-8" />
        <p class="text-lg">{dataContact.email}</p>
      </a>

      <!-- Dirección -->
      <a href={`https://www.google.com/maps/search/?q=${encodeURIComponent(dataContact.mapsDireccion)}`} target="_blank" class="flex items-center space-x-4" data-aos="fade-up" data-aos-duration="1000">
        <img src={dataContact.imagenDireccion} alt="Dirección" class="w-8 h-8" />
        <p class="text-lg">{dataContact.mapsDireccion}</p>
      </a>
    </div>

    <!-- Mapa -->
    <div class="rounded-lg overflow-hidden flex justify-center">
      <iframe
        src={dataContact.maps}
        class="rounded-lg w-full h-[250px] md:h-[400px] shadow-md"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        data-aos="fade-up"
        data-aos-duration="1000"
      ></iframe>
    </div>
  </div>
</div>

<script>
  // Función para hacer visible el componente después de 2 segundos
  setTimeout(() => {
    const ubicacion = document.getElementById('ubicacion');
    if (ubicacion) {
      ubicacion.style.visibility = 'visible';
      ubicacion.style.opacity = '1'; // Hace el componente visible
    }
  }, 2000); // Retraso de 2 segundos
</script>
